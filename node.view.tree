$mol_icon_clipboard_outline $mol_icon path \M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7Z

$mol_button_copy $mol_button_minor
	blobs /$mol_blob
		<= text_blob? $mol_blob /
			/BlobPart <= text <= title
			* type \text/plain
		<= html_blob? $mol_blob /
			/BlobPart <= html \
			* type \text/html
	data *
	sub /
		<= Icon $mol_icon_clipboard_outline
		<= title \

$mol_icon_chevron $mol_icon path \M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z

$mol_check_expand $mol_check
	Icon $mol_icon_chevron
	level 0
	style *
		^
		paddingLeft <= level_style \0px
	checked? <=> expanded? false
	enabled <= expandable false

$mol_expander $mol_list
	rows /
		<= Label $mol_view
			sub /
				<= Trigger $mol_check_expand
					checked? <=> expanded? false
					expandable <= expandable true
					label <= label /
						<= title
				<= Tools null
		<= Content $mol_list
			rows <= content /

$mol_icon_tick $mol_icon path \M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z

$mol_check_box $mol_check
	Icon $mol_icon_tick

$bog_stschool_edit $mol_expander
	room_link \
	task_link \
	title <= task_title
	Tools $mol_view
		sub /
			<= Current $mol_check_box
				title \На экране
				checked? <=> current? false
			<= Home $mol_check_box
				title \Домашка
				checked? <=> home? false
	content /
		<= Title_field $mol_form_field
			name \Название
			Content <= Title $mol_string
				value? <=> task_title? \
		<= Items $mol_list
			rows <= item_rows /
				<= Item_row* $mol_view
					sub /
						<= Item_numb* $mol_paragraph
							title <= item_numb* \
						<= Item_text* $mol_string
							hint \Предложение
							value? <=> item_text*? \
						<= Item_key* $mol_string
							hint \Ответ
							value? <=> item_key*? \
				<= Item_add $mol_button_minor
					title \Ещё пункт
					click? <=> item_add? null

$mol_icon_upload $mol_icon path \M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z

$mol_button_open $mol_button_minor
	sub /
		<= Icon $mol_icon_upload
		<= Native $mol_button_open_native
			files? <=> files_handled? <=> files? /File
			accept <= accept \
			multiple <= multiple true

$mol_button_open_native $mol_view
	dom_name \input
	files? /File
	attr *
		type \file
		accept <= accept \
		multiple <= multiple true
	event *
		change? <=> picked? null

$bog_stschool_teach $mol_page
	link \
	title <= group_title? \Группа
	tools /
		<= Stream_link $mol_link
			title \Стрим
			target \_blank
			arg *
				group <= link
				screen \stream
		<= Check_link $mol_link
			title \Проверка
			target \_blank
			arg *
				group <= link
				screen \check
	body /
		<= Title_field $mol_form_field
			name \Название группы
			Content <= Title $mol_string
				value? <=> group_title? \Группа
		<= Invite_field $mol_form_field
			name \Ссылка для учеников
			Content <= Invite $mol_view
				sub /
					<= Invite_uri $mol_string
						enabled false
						value <= invite_uri \
					<= Invite_copy $mol_button_copy
						title \Скопировать
						text <= invite_uri
		<= Tasks_field $mol_form_field
			name \Задания
			Content <= Tasks $mol_list
				rows <= task_rows /
					<= Task_row* $bog_stschool_edit
						room_link <= link
						task_link <= task_link* \
					<= Task_add $mol_button_minor
						title \Новое задание
						click? <=> task_add? null
		<= Decks_field $mol_form_field
			name \Презентации
			Content <= Decks $mol_list
				rows <= deck_rows /
					<= Deck_row* $mol_view
						sub /
							<= Deck_title* $mol_string
								value? <=> deck_title*? \
							<= Deck_drop* $mol_button_minor
								title \Убрать
								click? <=> deck_drop*? null
					<= Deck_add $mol_button_open
						accept \application/pdf
						multiple false
						sub /
							\Загрузить PDF
							<= Native
						files? <=> deck_files? /File
		<= Members_field $mol_form_field
			name <= members_name \Ученики
			Content <= Members $mol_list
				rows <= member_rows /
					<= Member_row* $mol_paragraph
						title <= member_name* \

$bog_stschool_answer $mol_list
	room_link \
	task_link \
	student_link \
	rows <= answer_rows /
	Title $mol_paragraph
		title <= task_title \
	Item_row* $mol_view
		sub <= item_sub* /
	Item_text* $mol_paragraph
		title <= item_text* \
	Item_last* $mol_view
		attr *
			bog_stschool_answer_mark <= item_mark* \
		sub /
			<= item_last* \
	Item_key* $mol_paragraph
		title <= item_key* \
	Item_input* $mol_string
		hint \Ваш ответ, Enter чтобы отправить
		value? <=> item_draft*? \
		submit? <=> item_send*? null
	Item_history* $mol_expander
		title \История
		content <= item_history* /
	History_row* $mol_view
		attr *
			bog_stschool_answer_mark <= history_mark* \
		sub /
			<= history_text* \
	Send $mol_button_major
		title \Сдать домашку
		click? <=> send? null
	Sent $mol_paragraph
		title <= sent_text \

$bog_stschool_study $mol_page
	link \
	title <= group_title \Группа
	tools /
		<= Status $giper_baza_status
	body <= body_rows /
	Current_head $mol_paragraph
		title \Сейчас на занятии
	Current $bog_stschool_answer
		room_link <= link
		task_link <= current_link \
		student_link <= student_link \
	Nothing $mol_paragraph
		title \Учитель ещё не открыл задание
	Home_head $mol_paragraph
		title \Домашние задания
	Home_row* $bog_stschool_answer
		room_link <= link
		task_link <= home_link* \
		student_link <= student_link

$mol_check_list $mol_view
	dictionary *
	Option* $mol_check
		checked? <=> option_checked*? false
		label <= option_label* /
			<= option_title* \
		enabled <= option_enabled* <= enabled true
		hint <= option_hint* \
		minimal_height 24
	options *
	keys /string
	sub <= items /$mol_check

$mol_switch $mol_check_list
	value? \

$bog_stschool_board $mol_view
	value? \
	sub /
		<= Tools $mol_view
			sub /
				<= Tool $mol_switch
					value? <=> tool? \pen
					options *
						pen \Перо
						text \Текст
						eraser \Ластик
				<= Color $mol_switch
					value? <=> color? \black
					options *
						black \Чёрный
						red \Красный
						blue \Синий
						green \Зелёный
				<= Clear $mol_button_minor
					title \Очистить
					click? <=> clear? null
		<= Sheet $mol_view
			attr *
				^
				bog_stschool_board_tool <= tool
			event *
				pointerdown? <=> down? null
				pointermove? <=> move? null
				pointerup? <=> up? null
				pointercancel? <=> up? null
				dblclick? <=> text_add? null
			sub /
				<= Paper $mol_svg_root
					view_box null
					sub <= strokes /
						<= Stroke* $mol_svg_path
							geometry <= stroke_geometry* \
							attr *
								^
								stroke <= stroke_color* \
				<= Texts $mol_view
					sub <= texts /
						<= Text* $bog_stschool_board_area
							value? <=> text_value*? \
							style *
								left <= text_x* 0
								top <= text_y* 0
$bog_stschool_board_area $mol_string
	dom_name \textarea
	hint \Текст
	submit_with_ctrl true

$mol_image $mol_view
	dom_name \img
	attr *any
		^
		src <= uri \
		title <= hint
		alt <= title \
		loading <= loading \lazy
		decoding <= decoding \async
		crossOrigin <= cors null
		width <= natural_width 0
		height <= natural_height 0
	event *any
		load? <=> load? null
	minimal_width 16
	minimal_height 16

$bog_stschool_slides $mol_view
	room_link \
	deck_link \
	plugins /
		<= Keys $mol_hotkey2
			action <= keys_action *
	sub /
		<= Stage $mol_view
			sub <= stage /
		<= Bar $mol_view
			sub /
				<= Prev $mol_button_minor
					title \←
					click? <=> prev? null
				<= Numb $mol_paragraph
					title <= numb \
				<= Next $mol_button_minor
					title \→
					click? <=> next? null
				<= Insert $mol_button_minor
					title \Вставить слайд после
					click? <=> insert? null
				<= Remove $mol_button_minor
					title \Убрать слайд
					click? <=> remove? null
	Page $mol_image
		uri <= page_uri \
		loading \eager
	Slide $bog_stschool_board
		value? <=> slide_board? \
	Wait $mol_paragraph
		title \Загружаем PDF…

$bog_stschool_stream $mol_view
	link \
	sub /
		<= Task $mol_view
			sub <= task_sub /
				<= Task_title $mol_paragraph
					title <= task_title \
				<= Task_item* $mol_paragraph
					title <= task_item* \
		<= Stage $mol_view
			sub <= stage /
		<= Tabs $mol_switch
			value? <=> tab? \board
			options <= tab_options *
	Board $bog_stschool_board
		value? <=> board? \
	Slides* $bog_stschool_slides
		room_link <= link
		deck_link <= deck_link* \

$mol_row $mol_view

$bog_stschool_cell $mol_view
	room_link \
	task_link \
	student_link \
	item 0
	attr *
		^
		bog_stschool_cell_mark <= mark \
	sub <= cell_sub /
	Text $mol_paragraph
		title <= text \
	Empty $mol_paragraph
		title \—
	Marks $mol_view
		sub /
			<= Ok $mol_check_box
				title \верно
				checked? <=> ok? false
			<= Bad $mol_check_box
				title \неверно
				checked? <=> bad? false
	History $mol_expander
		title <= history_title \
		content <= history /
	History_row* $mol_view
		attr *
			bog_stschool_cell_mark <= history_mark* \
		sub /
			<= history_text* \

$bog_stschool_check $mol_page
	link \
	title <= group_title \Проверка
	tools /
		<= Task_pick $mol_select
			hint \Задание
			options <= task_options /string
			dictionary <= task_dictionary *
			value? <=> task_link? \
		<= Status $giper_baza_status
	body <= body_rows /
	Grid $mol_list
		rows <= grid_rows /
			<= Head $mol_row
				sub <= head_cells /
					<= Head_name $mol_view
						sub / \Ученик
					<= Head_item* $mol_paragraph
						title <= item_text* \
			<= Student_row* $mol_row
				sub <= student_cells* /
			<= Student_name* $mol_view
				sub /
					<= student_name* \
					<= student_sent* \
			<= Cell* $bog_stschool_cell
				room_link <= link
				task_link <= task_link
				student_link <= cell_student* \
				item <= cell_item* 0
	Nobody $mol_paragraph
		title \В группе пока нет учеников

$mol_status $mol_view
	status <= title
	minimal_height 24
	minimal_width 0
	sub /
		<= message \

$mol_form $mol_list
	submit_allowed true
	submit_blocked false
	event *
		^
		keydown? <=> keydown? null
	save? null
	message_done @ \Saved
	errors *string
		\Form invalid
			<= form_invalid @ \Form is not valid
	rows /
		<= Body $mol_list
			sub <= body <= form_fields /$mol_form_field
		<= Foot $mol_row
			sub <= foot <= buttons /$mol_view
				<= Submit $mol_button_major
					title <= submit_title @ \Save
					hint <= submit_hint \
					activate? => submit_activate?
					click? <=> submit? null
				<= Result $mol_status
					message <= result? null

$bog_stschool_app $mol_view
	plugins /
		<= Theme $bog_theme_auto
			theme_light \$mol_theme_calm_light
			theme_dark \$mol_theme_calm_dark
			themes /
				\$mol_theme_calm_light
				\$mol_theme_calm_dark
	sub <= screens /
	Book $mol_book2
		pages <= pages /
	Home $mol_page
		title \Уроки
		tools /
			<= Status $giper_baza_status
			<= Theme_toggle $bog_theme_toggle
				theme_auto <= Theme
		body /
			<= Name_field $mol_form_field
				name \Как вас зовут
				Content <= Name $mol_string
					hint \Имя и фамилия
					value? <=> name? \
			<= Teach_field $mol_form_field
				name \Веду группы
				Content <= Teach $mol_view
					sub /
						<= Teach_list $mol_list
							rows <= teach_rows /
								<= Teach_link* $mol_link
									title <= group_title* \
									arg *
										group <= group_link* \
						<= Group_add $mol_button_minor
							title \Новая группа
							click? <=> group_add? null
			<= Learn_field $mol_form_field
				name \Учусь
				Content <= Learn_list $mol_list
					rows <= learn_rows /
						<= Learn_link* $mol_link
							title <= group_title* \
							arg *
								group <= group_link* \
	Join $bog_stschool_join
		link <= join_link \
	Teach_page $bog_stschool_teach
		link <= group_link_current \
	Study $bog_stschool_study
		link <= group_link_current \
	Stream $bog_stschool_stream
		link <= group_link_current \
	Check $bog_stschool_check
		link <= group_link_current \
